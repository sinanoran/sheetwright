<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <!--
      Globalization is ON. A spreadsheet carries dates and decimals, and a
      library that formats them under the invariant culture only is a library
      that hands a German reader an American date. CultureInfo.GetCultureInfo
      throws for every tag but the invariant one when this is true, and
      SpreadsheetCultureTests would fail — see tests/Sheetwright.Tests.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup Label="Repository">
    <!--
      The release workflow passes -p:Version from the git tag, so a published
      package cannot disagree with the tag that produced it. This is what a
      local `dotnet pack` produces, and it is deliberately not a release
      version.
    -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <Authors>Sinan Oran</Authors>
    <Company>Sheetwright contributors</Company>
    <Product>Sheetwright</Product>
    <Copyright>Copyright (c) Sheetwright contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/sinanoran/sheetwright</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sinanoran/sheetwright</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

</Project>
